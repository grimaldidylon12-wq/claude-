{
  "name": "scrollstop",
  "version": "1.0.0",
  "description": "Write one post. Scrollstop scores it, fixes it, adapts it and schedules it for every social feed.",
  "type": "module",
  "main": "src/core/index.js",
  "exports": {
    ".": "./src/core/index.js"
  },
  "bin": {
    "scrollstop": "cli/scrollstop.js"
  },
  "scripts": {
    "start": "node scripts/serve.js",
    "test": "node --test test/*.test.js",
    "cli": "node cli/scrollstop.js"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": ["social media", "marketing", "copywriting", "linkedin", "instagram", "tiktok", "twitter", "utm", "content calendar"]
}
